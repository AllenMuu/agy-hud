{
  "$schema": "https://raw.githubusercontent.com/AllenMuu/agy-hud/main/schema.json",
  "preset": "full",
  "language": "zh-Hans",
  "display": {
    "preset": "full",
    "language": "zh-Hans",
    "lineLayout": "expanded",
    "showModel": true,
    "showWorkspace": true,
    "showGit": true,
    "showContextBar": true,
    "contextValue": "percent",
    "showTools": true,
    "showAgents": true,
    "showTodos": true,
    "showQuota": true,
    "showDuration": true,
    "barWidth": 10,
    "pathLevels": 1,
    "maxWidth": null
  },
  "git": {
    "enabled": true,
    "showDirty": true,
    "showAheadBehind": true,
    "showFileStats": false
  },
  "thresholds": {
    "contextWarning": 70,
    "contextCritical": 85,
    "quotaWarning": 75,
    "quotaCritical": 90
  }
}
