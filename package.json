{
  "name": "@allenmuu/agy-hud",
  "version": "1.1.0",
  "description": "Real-time, high-performance status-line HUD plugin for Google Antigravity CLI",
  "main": "dist/agy-hud.js",
  "bin": {
    "agy-hud": "./dist/agy-hud.js"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "hooks",
    "plugin.json",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run typecheck"
  },
  "keywords": [
    "antigravity",
    "antigravity-cli",
    "statusline",
    "hud",
    "plugin",
    "tui",
    "npx"
  ],
  "author": "Allen Muu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllenMuu/agy-hud.git"
  },
  "homepage": "https://github.com/AllenMuu/agy-hud#readme",
  "bugs": {
    "url": "https://github.com/AllenMuu/agy-hud/issues"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
